{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IdlePort",
  "version": "0.1.0",
  "identifier": "com.idleport.app",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/windows/package-identity.ps1"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "windows/idleport-identity.msix": "idleport-identity.msix"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "bannerPath": "icons/installer-banner.bmp",
        "dialogImagePath": "icons/installer-dialog.bmp"
      }
    }
  }
}